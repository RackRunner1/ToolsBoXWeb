# Example file: adjust before using it on the server.
[Unit]
Description=TBXM
After=network.target

[Service]
Type=simple
ExecStart=/opt/tbxm/server
Environment=TBXM_HOST=0.0.0.0
Environment=TBXM_PORT=8080
Environment=TBXM_ROOT=/var/www/tbxm
User=www-data
Group=www-data
Restart=on-failure
RestartSec=2
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectHostname=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
UMask=0027

[Install]
WantedBy=multi-user.target
